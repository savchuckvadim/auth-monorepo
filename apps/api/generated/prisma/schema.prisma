generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid())
  name           String     @db.VarChar(255)
  email          String     @unique(map: "users_email_unique") @db.VarChar(255)
  isAcivated     Boolean    @default(false)
  activationLink String     @unique(map: "users_activation_link_unique") @db.VarChar(255)
  role           user_roles
  password       String
  createdAt      DateTime?  @default(now())
  updatedAt      DateTime?  @default(now())
  tokens         Token[]

  // Messenger relations
  createdChats  Chat[]              @relation("ChatCreator")
  chatMembers   ChatMember[]
  messages      Message[]
  devices       Device[]
  pushDevices   PushDevice[]
  sentCalls     Call[]              @relation("CallInitiator")
  receivedCalls Call[]              @relation("CallReceiver")
  messageReads  MessageReadStatus[]
  messageLikes  MessageLike[]
  chats         Chat[]

  // Followers relations
  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  // Profile relation
  profile Profile?

  // Password reset tokens
  passwordResetTokens PasswordResetToken[]

  // Posts relations
  posts         Post[]     @relation("PostWall")
  authoredPosts Post[]     @relation("PostAuthor")
  postLikes     PostLike[]

  invitationsSent     Invitation[] @relation("InvitationsSent")
  invitationsReceived Invitation[] @relation("InvitationsReceived")

  @@unique([email])
  @@map("users")
}

model Token {
  id           String @id @default(uuid())
  userId       String @map("user_id") @db.VarChar(255)
  refreshToken String @unique @map("refresh_token") @db.VarChar(512)

  // Метаданные сессии (устройство, откуда пришёл запрос)
  deviceId  String? @map("device_id") @db.VarChar(255)
  userAgent String? @map("user_agent") @db.VarChar(500)
  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("tokens")
}

/// Одноразовый токен для сброса пароля. В БД хранится только хеш (SHA-256),
/// исходное значение уходит пользователю на email и больше нигде не живёт.
/// После потребления помечаем `consumedAt` — это даёт защиту от повторного использования.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id") @db.VarChar(255)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum user_roles {
  owner
  admin
  user
}

// Messenger models

model Chat {
  id             String             @id @default(uuid())
  type           ChatType           @default(PRIVATE)
  encryptionMode ChatEncryptionMode @default(NONE) @map("encryption_mode")
  name           String?            @db.VarChar(255) // Для групповых чатов
  description    String?            @db.Text // Для групповых чатов
  avatar         String?            @db.VarChar(500) // URL аватара
  createdBy      String             @map("created_by") @db.VarChar(255)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Auto-delete each message after N seconds (optional; 0 = off). Client + jobs should enforce.
  disappearingMessageSeconds Int?      @map("disappearing_message_seconds")
  /// When set, entire chat is deleted at this time (optional).
  scheduledDeletionAt        DateTime? @map("scheduled_deletion_at")

  members  ChatMember[]
  messages Message[]
  calls    Call[]

  creator User    @relation("ChatCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])
  userId  String?

  @@index([type])
  @@index([encryptionMode])
  @@index([createdAt])
  @@map("chats")
}

model ChatMember {
  id         String         @id @default(uuid())
  chatId     String         @map("chat_id") @db.VarChar(255)
  userId     String         @map("user_id") @db.VarChar(255)
  role       ChatMemberRole @default(MEMBER)
  joinedAt   DateTime       @default(now()) @map("joined_at")
  leftAt     DateTime?      @map("left_at")
  lastReadAt DateTime?      @map("last_read_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@index([chatId])
  @@map("chat_members")
}

model Message {
  id         String      @id @default(uuid())
  chatId     String      @map("chat_id") @db.VarChar(255)
  senderId   String      @map("sender_id") @db.VarChar(255)
  content    String      @db.Text
  type       MessageType @default(TEXT)
  fileUrl    String?     @map("file_url") @db.VarChar(500)
  fileName   String?     @map("file_name") @db.VarChar(255)
  fileSize   Int?        @map("file_size")
  replyToId  String?     @map("reply_to_id") @db.VarChar(255)
  editedAt   DateTime?   @map("edited_at")
  deletedAt  DateTime?   @map("deleted_at")
  /// Для `CALL_EVENT` — { direction: 'outgoing'|'incoming', reason: 'missed'|'accepted'|..., callType: 'audio'|'video', durationMs?, callId?, initiatorId? }
  metadata   Json?       @map("metadata")
  /// Денормализованный счётчик лайков. Инкрементируется / декрементируется в транзакции с записью/удалением `MessageLike`.
  likesCount Int         @default(0) @map("likes_count")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  /// When set, message is permanently removed after this instant (disappearing messages).
  expiresAt DateTime? @map("expires_at")

  // E2EE (Signal): when isEncrypted, content holds ciphertext (base64); optional per-device fan-out
  isEncrypted       Boolean @default(false) @map("is_encrypted")
  toDeviceId        String? @map("to_device_id") @db.VarChar(255)
  senderDeviceId    String? @map("sender_device_id") @db.VarChar(255)
  signalMessageType String? @map("signal_message_type") @db.VarChar(50)
  registrationId    Int?    @map("registration_id")

  chat        Chat                @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo     Message?            @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Message[]           @relation("MessageReply")
  readStatus  MessageReadStatus[]
  toDevice    Device?             @relation("MessageTargetDevice", fields: [toDeviceId], references: [id], onDelete: SetNull)
  fromDevice  Device?             @relation("MessageSenderDevice", fields: [senderDeviceId], references: [id], onDelete: SetNull)
  likes       MessageLike[]
  attachments MessageAttachment[]

  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([isEncrypted])
  @@index([toDeviceId])
  @@index([senderDeviceId])
  @@map("messages")
}

/// Client-registered device for Signal E2EE (multi-device)
model Device {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id") @db.VarChar(255)
  clientDeviceId     String    @unique @map("client_device_id") @db.VarChar(255)
  name               String?   @db.VarChar(255)
  type               String    @db.VarChar(50)
  registrationId     Int       @map("registration_id")
  identityKey        String    @map("identity_key") @db.Text
  signedPreKey       String    @map("signed_pre_key") @db.Text
  signedPreKeySig    String    @map("signed_pre_key_sig") @db.Text
  signedPreKeyExpiry DateTime? @map("signed_pre_key_expiry")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  preKeys        PreKey[]
  otPreKeys      OneTimePreKey[]
  targetMessages Message[]       @relation("MessageTargetDevice")
  sentMessages   Message[]       @relation("MessageSenderDevice")

  @@unique([userId, clientDeviceId])
  @@index([userId])
  @@index([clientDeviceId])
  @@map("devices")
}

model PreKey {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id") @db.VarChar(255)
  keyId     Int      @map("key_id")
  publicKey String   @map("public_key") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId])
  @@map("prekeys")
}

model OneTimePreKey {
  id        String    @id @default(uuid())
  deviceId  String    @map("device_id") @db.VarChar(255)
  keyId     Int       @map("key_id")
  publicKey String    @map("public_key") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
  @@index([deviceId])
  @@index([usedAt])
  @@map("one_time_prekeys")
}

model MessageReadStatus {
  id        String   @id @default(uuid())
  messageId String   @map("message_id") @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(255)
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
  @@map("message_read_status")
}

/// Лайк сообщения. Уникальность `(messageId,userId)` гарантирует
/// идемпотентность — повторный `POST /messages/:id/like` работает как toggle.
model MessageLike {
  id        String   @id @default(uuid())
  messageId String   @map("message_id") @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_likes")
}

/// Полиморфное вложение к сообщению. Один `Message` может иметь N штук.
/// `messageId = null` допустим временно — upload эндпоинт создаёт
/// «висячий» attachment, который клиент привяжет через `POST /messages`
/// в `attachmentIds`. Orphan’ы подчищает cron (TTL 1 час).
model MessageAttachment {
  id           String                @id @default(uuid())
  messageId    String?               @map("message_id") @db.VarChar(255)
  uploaderId   String                @map("uploader_id") @db.VarChar(255)
  kind         MessageAttachmentKind
  /// URL в S3 / CDN (для MEDIA/VOICE/CIRCLE/FILE). Для POST_SHARE/FORWARD_SNAPSHOT обычно null.
  url          String?               @db.VarChar(500)
  name         String?               @db.VarChar(255)
  size         Int?
  mimeType     String?               @map("mime_type") @db.VarChar(100)
  durationMs   Int?                  @map("duration_ms")
  width        Int?
  height       Int?
  thumbnailUrl String?               @map("thumbnail_url") @db.VarChar(500)
  /// Для VOICE — массив peaks (waveform), для FORWARD_SNAPSHOT — снапшот исходника,
  /// для POST_SHARE — оставляем null (postId хранится в колонке `postId`).
  metadata     Json?
  /// Для POST_SHARE. По нему строится индекс — быстрый поиск «где репостили этот пост».
  postId       String?               @map("post_id") @db.VarChar(255)
  createdAt    DateTime              @default(now()) @map("created_at")

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId])
  @@index([postId])
  @@map("message_attachments")
}

enum MessageAttachmentKind {
  IMAGE
  VIDEO
  AUDIO
  VOICE
  CIRCLE
  FILE
  POST_SHARE
  FORWARD_SNAPSHOT
}

model Call {
  id          String           @id @default(uuid())
  chatId      String           @map("chat_id") @db.VarChar(255)
  initiatorId String           @map("initiator_id") @db.VarChar(255)
  receiverId  String?          @map("receiver_id") @db.VarChar(255)
  type        CallType         @default(VIDEO)
  status      CallStatus       @default(INITIATED)
  startedAt   DateTime?        @map("started_at")
  endedAt     DateTime?        @map("ended_at")
  duration    Int? // Длительность в секундах
  endedReason CallEndedReason? @map("ended_reason")
  createdAt   DateTime         @default(now())

  chat      Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  initiator User  @relation("CallInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  receiver  User? @relation("CallReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  @@index([chatId])
  @@index([initiatorId])
  @@index([status])
  @@map("calls")
}

enum ChatType {
  PRIVATE
  GROUP
  SECRET
}

/// Orthogonal to ChatType: messenger E2EE vs plaintext-at-rest on server
enum ChatEncryptionMode {
  NONE
  SIGNAL
}

enum ChatMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
  SYSTEM
  /// Специализированное системное сообщение о событии звонка — рендерится
  /// клиентом по `Message.metadata` (direction/reason/callType/durationMs).
  CALL_EVENT
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
}

enum CallEndedReason {
  ACCEPTED
  REJECTED
  MISSED
  CANCELED
  FAILED
  TIMEOUT
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum PushProvider {
  FCM
  APNS
  APNS_VOIP
}

model PushDevice {
  id             String       @id @default(uuid())
  userId         String       @map("user_id") @db.VarChar(255)
  /// Stable per-app-install id from the client (e.g. keychain UUID). Optional for legacy rows.
  installationId String?      @map("installation_id") @db.VarChar(128)
  platform       PushPlatform
  provider       PushProvider
  token          String       @unique @db.VarChar(512)
  voipToken      String?      @map("voip_token") @db.VarChar(512)
  isActive       Boolean      @default(true) @map("is_active")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, installationId], map: "push_devices_user_installation_uidx")
  @@index([userId, isActive])
  @@index([platform, provider])
  @@map("push_devices")
}

// Followers model

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id") @db.VarChar(255)
  followingId String   @map("following_id") @db.VarChar(255)
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Profile model

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique(map: "profiles_user_id_unique") @map("user_id") @db.VarChar(255)
  name      String?  @db.VarChar(255)
  about     String?  @db.VarChar(1000) // Ограничение 1000 символов
  avatar    String?  @db.VarChar(500) // URL аватара
  hero      String?  @db.VarChar(500) // URL hero изображения
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("profiles")
}

// Posts model

model Post {
  id             String    @id @default(uuid())
  userId         String    @map("user_id") @db.VarChar(255) // Владелец стены (на чьей стене пост)
  authorId       String?   @map("author_id") @db.VarChar(255) // Автор поста (кто написал)
  text           String?   @db.VarChar(2000) // Ограничение 2000 символов
  image          String?   @db.VarChar(500) // URL изображения
  audio          String?   @db.VarChar(500) // URL аудио файла
  video          String?   @db.VarChar(500) // URL видео файла
  link           String?   @db.VarChar(500) // Ссылка
  views          Int       @default(0)
  originalPostId String?   @map("original_post_id") @db.VarChar(255) // Для репостов
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime? @map("deleted_at")

  user         User       @relation("PostWall", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author       User?      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  originalPost Post?      @relation("PostRepost", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts      Post[]     @relation("PostRepost")
  likes        PostLike[]

  @@index([userId])
  @@index([authorId])
  @@index([userId, createdAt])
  @@index([originalPostId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id") @db.VarChar(255)
  userId    String   @map("user_id") @db.VarChar(255)
  isLike    Boolean  @default(true) // true = like, false = dislike
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

enum InvitationType {
  SECRET_PRIVATE
  GROUP_JOIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model Invitation {
  id             String           @id @default(uuid())
  type           InvitationType
  status         InvitationStatus @default(PENDING)
  fromUserId     String           @map("from_user_id") @db.VarChar(255)
  toUserId       String           @map("to_user_id") @db.VarChar(255)
  payload        Json?
  resolvedChatId String?          @map("resolved_chat_id") @db.VarChar(255)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  fromUser User @relation("InvitationsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("InvitationsReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId])
  @@map("invitations")
}
