# URL бэкенда. Next.js заменяет NEXT_PUBLIC_* на строковый литерал при
# сборке, значение читается и в браузере, и в SSR.
#
# Локальная разработка (бэк стартует на 3000):
NEXT_PUBLIC_API_URL=http://localhost:3000
#
# Если API-контейнер из docker-compose.yml маппится на 7000:
# NEXT_PUBLIC_API_URL=http://localhost:7000
#
# Прод:
# NEXT_PUBLIC_API_URL=https://api.sociopath-network.ru
